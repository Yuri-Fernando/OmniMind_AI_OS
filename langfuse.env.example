# Copie para `.env.langfuse` (git-ignorado via .env.*) e preencha. NUNCA commite valores reais.
# Gere segredos fortes:  python -c "import secrets; print(secrets.token_hex(32))"

# --- stack self-host (docker-compose.langfuse.yml) ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=          # 64 caracteres hex (openssl rand -hex 32)
LANGFUSE_NEXTAUTH_SECRET=

# --- cliente (vão no .env do OmniMind depois de criar o projeto na UI) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
